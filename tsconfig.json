{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",
    "lib": [
      "DOM"
    ],
    "strictNullChecks": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationDir": "dist"
  },
  "include": [
    "src/**/*"
  ]
}
